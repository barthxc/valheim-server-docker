# =====================================================================================
#  .env — Docker Compose variables (panel, paths, passwords).
#  Copy this file to ".env" (or run ./setup.sh / setup.ps1, which does it for you)
#  and fill in the values. NEVER commit your real .env (it is in .gitignore).
# =====================================================================================

# Absolute path of THIS folder, as the Docker daemon sees it.
# The panel runs "docker compose" through the Docker socket to re-create the server,
# so the paths in docker-compose.yml must be host paths, not container paths.
#   Linux / macOS ........ /home/you/valheim-server-docker   (output of: pwd)
#   Windows + Docker Desktop (WSL2) .. /run/desktop/mnt/host/c/Users/You/valheim-server-docker
#                          (C:\Users\You\valheim-server-docker -> drive letter in lowercase)
PROJECT_DIR=/home/you/valheim-server-docker

# Password shared by the panel and the ValheimRcon mod (the panel writes it into the mod's .cfg).
# Long random string; you never type it anywhere. Generate one with: openssl rand -hex 16
RCON_PASSWORD=change-me-rcon

# Password to log into the web panel. Empty = no login (only OK if the panel is not reachable by others).
PANEL_PASSWORD=change-me-panel

# Host port of the web panel -> http://localhost:8082
PANEL_PORT=8082

# Address shown in the panel for players on your LAN (your PC's local IP + game port).
# Windows: ipconfig · Linux: ip -4 addr · macOS: ipconfig getifaddr en0
LOCAL_ADDRESS=192.168.1.50:2456

# Public address shown in the panel (playit.gg tunnel, or your public IP:2456 if you forward ports). Optional.
PUBLIC_ADDRESS=

# Time zone of the panel (use the same as TZ in valheim.env). List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Madrid

# Language of the messages the panel sends INTO the game (restart warnings) and of the default kits: es | en.
# The panel UI language is chosen per browser with the ES/EN selector.
PANEL_LANG=en

# Secret key of a playit.gg agent (only if you use the "playit" profile). See README > playit.gg
PLAYIT_SECRET_KEY=
