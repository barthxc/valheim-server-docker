# =====================================================================================
#  valheim.env — settings of the Valheim server (image ghcr.io/lloesche/valheim-server).
#  Copy this file to "valheim.env". The panel (⚙️ Settings) edits this same file.
#  All variables of the image: https://github.com/lloesche/valheim-server-docker#environment-variables
# =====================================================================================

# Name shown in the server list / join screen
SERVER_NAME=My Valheim Server
# World name (letters, numbers, - and _). Changing it creates a NEW world (the old one is kept)
WORLD_NAME=Midgard
# Game password: at least 5 characters and it cannot be part of SERVER_NAME
SERVER_PASS=change-me
# Show the server in the public community list (true/false)
SERVER_PUBLIC=false
# Extra launch arguments. Examples:
#   -crossplay                              join code + Xbox / Game Pass players
#   -preset hard                            normal | casual | easy | hard | hardcore | immersive | hammer
#   -modifier combat hard                   combat: veryeasy easy hard veryhard
#   -modifier deathpenalty casual           deathpenalty: casual veryeasy easy hard hardcore
#   -modifier resources more                resources: muchless less more muchmore most
#   -modifier raids none                    raids: none muchless less more muchmore
#   -modifier portals casual                portals: casual hard veryhard
#   -setkey nobuildcost                     nobuildcost | playerevents | passivemobs | nomap
SERVER_ARGS=-crossplay

# Mods via BepInEx. Must be true: the panel needs the ValheimRcon mod (installed automatically)
BEPINEX=true
# Exposes status.json (players, version) inside the Docker network; the panel uses it
STATUS_HTTP=true

# Automatic world backups (cron format, container time zone)
BACKUPS=true
BACKUPS_CRON=0 */2 * * *
# Delete backups older than N days
BACKUPS_MAX_AGE=3
# Daily restart (cron). 0 5 * * * = every day at 5:00 (the image default). Empty = never
RESTART_CRON=0 5 * * *
# Update Valheim automatically, but only when nobody is online
UPDATE_IF_IDLE=true

# Time zone of the server (log timestamps, cron schedules)
TZ=Europe/Madrid

# --- Other useful variables of the image (uncomment to use) ---
# UPDATE_CRON=*/15 * * * *   # How often to check for game updates
# RESTART_IF_IDLE=true       # Restart after an update only if nobody is online
# BACKUPS_DIRECTORY=/config/backups
# BACKUPS_IF_IDLE=true       # Skip backups while nobody plays
# PUID=0                     # User/group ID that owns the files in data/
# PGID=0
